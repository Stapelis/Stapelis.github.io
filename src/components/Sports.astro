---
import { siteConfig } from "../config";
const hasSports = siteConfig.sportsAndActivities && siteConfig.sportsAndActivities.length > 0;
---

{
  hasSports && (
    <section id="sports" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4 lg:pr-4">
            <h2
              class="max-w-[280px] text-3xl sm:text-4xl md:text-5xl xl:text-5xl font-bold text-gray-900 leading-[0.9] tracking-[-0.06em]"
              data-fr={siteConfig.translations.fr.sportsTitle}
              data-en={siteConfig.translations.en.sportsTitle}
            >
              {siteConfig.translations.fr.sportsTitle}
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8">
            <div class="grid gap-4 sm:grid-cols-2">
              {siteConfig.sportsAndActivities.map((activity) => (
                <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-4 sm:p-5 hover:shadow-md transition-shadow duration-300">
                  <p
                    class="text-lg sm:text-xl font-semibold text-gray-900"
                    data-fr={activity.name.fr}
                    data-en={activity.name.en}
                  >
                    {activity.name.fr}
                  </p>
                  <p
                    class="mt-2 text-sm sm:text-base"
                    style={{ color: siteConfig.accentColor }}
                    data-fr={activity.detail.fr}
                    data-en={activity.detail.en}
                  >
                    {activity.detail.fr}
                  </p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
