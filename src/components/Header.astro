---
import { siteConfig } from "../config";
---

<header class="flex justify-between items-center p-6 max-w-6xl mx-auto">
  <!-- Liens de navigation (sans le nom "Thomas Stapelfeld") -->
  <nav class="flex items-center gap-6">
    <a href="#about" class="text-sm font-medium hover:underline">About</a>
    <a href="#projects" class="text-sm font-medium hover:underline">Projects</a>
    <a href="#experience" class="text-sm font-medium hover:underline">Experience</a>
    <a href="#education" class="text-sm font-medium hover:underline">Education</a>
  </nav>

  <!-- Bouton de langue interactif -->
  <button 
    id="lang-toggle" 
    class="px-3 py-1.5 text-sm font-medium border rounded-md transition hover:bg-gray-100 flex items-center gap-2 cursor-pointer"
  >
    🌐 <span id="lang-text">EN</span>
  </button>
</header>

<script>
  const toggleBtn = document.getElementById('lang-toggle');
  const langText = document.getElementById('lang-text');

  let currentLang = localStorage.getItem('portfolio-lang') || 'fr';

  function updateLanguage(lang: string) {
    localStorage.setItem('portfolio-lang', lang);
    if (langText) {
      langText.textContent = lang === 'fr' ? 'EN' : 'FR';
    }
    document.documentElement.setAttribute('data-lang', lang);
  }

  updateLanguage(currentLang);

  toggleBtn?.addEventListener('click', () => {
    currentLang = currentLang === 'fr' ? 'en' : 'fr';
    updateLanguage(currentLang);
    window.location.reload();
  });
</script>
