---
import { siteConfig } from "../config";
---

<header class="flex justify-between items-center p-6 max-w-6xl mx-auto">
  <nav class="flex items-center gap-6">
    <a
      href="#about"
      class="text-sm font-medium hover:underline"
      data-fr={siteConfig.translations.fr.nav.about}
      data-en={siteConfig.translations.en.nav.about}
    >
      {siteConfig.translations.fr.nav.about}
    </a>
    <a
      href="#skills"
      class="text-sm font-medium hover:underline"
      data-fr={siteConfig.translations.fr.nav.skills}
      data-en={siteConfig.translations.en.nav.skills}
    >
      {siteConfig.translations.fr.nav.skills}
    </a>
    <a
      href="#sports"
      class="text-sm font-medium hover:underline"
      data-fr={siteConfig.translations.fr.nav.sports}
      data-en={siteConfig.translations.en.nav.sports}
    >
      {siteConfig.translations.fr.nav.sports}
    </a>
    <a
      href="#languages"
      class="text-sm font-medium hover:underline"
      data-fr={siteConfig.translations.fr.nav.languages}
      data-en={siteConfig.translations.en.nav.languages}
    >
      {siteConfig.translations.fr.nav.languages}
    </a>
    <a
      href="#projects"
      class="text-sm font-medium hover:underline"
      data-fr={siteConfig.translations.fr.nav.projects}
      data-en={siteConfig.translations.en.nav.projects}
    >
      {siteConfig.translations.fr.nav.projects}
    </a>
    <a
      href="#experience"
      class="text-sm font-medium hover:underline"
      data-fr={siteConfig.translations.fr.nav.experience}
      data-en={siteConfig.translations.en.nav.experience}
    >
      {siteConfig.translations.fr.nav.experience}
    </a>
    <a
      href="#education"
      class="text-sm font-medium hover:underline"
      data-fr={siteConfig.translations.fr.nav.education}
      data-en={siteConfig.translations.en.nav.education}
    >
      {siteConfig.translations.fr.nav.education}
    </a>
  </nav>

  <div class="flex items-center gap-3">
    <button
      id="theme-toggle"
      class="px-3 py-1.5 text-sm font-medium border rounded-md transition hover:bg-gray-100 dark:hover:bg-slate-800 flex items-center gap-2 cursor-pointer"
      aria-label="Toggle color theme"
      type="button"
    >
      <span id="theme-icon" aria-hidden="true">☀️</span>
    </button>

    <button
      id="lang-toggle"
      class="px-3 py-1.5 text-sm font-medium border rounded-md transition hover:bg-gray-100 dark:hover:bg-slate-800 flex items-center gap-2 cursor-pointer"
      aria-label="Toggle language"
      type="button"
    >
      🌐 <span id="lang-text">FR</span>
    </button>
  </div>
</header>

<script>
  import { siteConfig } from "../config";

  const LANG_STORAGE_KEY = "portfolio-lang";
  const THEME_STORAGE_KEY = "portfolio-theme";
  const langToggle = document.getElementById("lang-toggle");
  const langText = document.getElementById("lang-text");
  const themeToggle = document.getElementById("theme-toggle");
  const themeIcon = document.getElementById("theme-icon");

  const getPreferredTheme = () => {
    const saved = localStorage.getItem(THEME_STORAGE_KEY);
    if (saved === "light" || saved === "dark") {
      return saved;
    }

    return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  };

  const applyTheme = (theme) => {
    const isDark = theme === "dark";
    document.documentElement.classList.toggle("dark", isDark);
    localStorage.setItem(THEME_STORAGE_KEY, theme);

    if (themeIcon) {
      themeIcon.textContent = isDark ? "☀️" : "🌙";
    }

    if (themeToggle) {
      themeToggle.setAttribute("aria-label", isDark ? "Switch to light mode" : "Switch to dark mode");
    }
  };

  const applyLanguage = (lang) => {
    localStorage.setItem(LANG_STORAGE_KEY, lang);
    document.documentElement.setAttribute("data-lang", lang);

    if (langText) {
      langText.textContent = lang.toUpperCase();
    }

    document.querySelectorAll("[data-fr][data-en]").forEach((el) => {
      const translatedText = el.getAttribute(`data-${lang}`);
      if (translatedText) {
        el.textContent = translatedText;
      }
    });

    const pageTitle = siteConfig.title[lang] ?? siteConfig.title.fr;
    document.title = `${siteConfig.name} - ${pageTitle}`;
  };

  let currentLang = localStorage.getItem(LANG_STORAGE_KEY) || "fr";
  let currentTheme = getPreferredTheme();

  applyTheme(currentTheme);
  applyLanguage(currentLang);

  themeToggle?.addEventListener("click", () => {
    currentTheme = currentTheme === "dark" ? "light" : "dark";
    applyTheme(currentTheme);
  });

  langToggle?.addEventListener("click", () => {
    currentLang = currentLang === "fr" ? "en" : "fr";
    applyLanguage(currentLang);
  });
</script>














































































































































































































































































































































































































































































































































































































































































































































































