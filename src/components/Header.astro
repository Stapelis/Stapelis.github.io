---
import { siteConfig } from "../config";
---

<header class="flex justify-between items-center p-6 max-w-6xl mx-auto">
  <nav class="flex items-center gap-6">
    <a
      href="#about"
      class="text-sm font-medium hover:underline"
      data-fr={siteConfig.translations.fr.nav.about}
      data-en={siteConfig.translations.en.nav.about}
    >
      {siteConfig.translations.fr.nav.about}
    </a>
    <a
      href="#projects"
      class="text-sm font-medium hover:underline"
      data-fr={siteConfig.translations.fr.nav.projects}
      data-en={siteConfig.translations.en.nav.projects}
    >
      {siteConfig.translations.fr.nav.projects}
    </a>
    <a
      href="#experience"
      class="text-sm font-medium hover:underline"
      data-fr={siteConfig.translations.fr.nav.experience}
      data-en={siteConfig.translations.en.nav.experience}
    >
      {siteConfig.translations.fr.nav.experience}
    </a>
    <a
      href="#education"
      class="text-sm font-medium hover:underline"
      data-fr={siteConfig.translations.fr.nav.education}
      data-en={siteConfig.translations.en.nav.education}
    >
      {siteConfig.translations.fr.nav.education}
    </a>
  </nav>

  <button
    id="lang-toggle"
    class="px-3 py-1.5 text-sm font-medium border rounded-md transition hover:bg-gray-100 flex items-center gap-2 cursor-pointer"
    aria-label="Toggle language"
  >
    🌐 <span id="lang-text">FR</span>
  </button>
</header>

<script>
  import { siteConfig } from "../config";

  const STORAGE_KEY = "portfolio-lang";
  const toggleBtn = document.getElementById("lang-toggle");
  const langText = document.getElementById("lang-text");

  let currentLang = localStorage.getItem(STORAGE_KEY) || "fr";

  function updateLanguage(lang) {
    localStorage.setItem(STORAGE_KEY, lang);
    document.documentElement.setAttribute("data-lang", lang);

    if (langText) {
      langText.textContent = lang.toUpperCase();
    }

    document.querySelectorAll("[data-fr][data-en]").forEach((el) => {
      const translatedText = el.getAttribute(`data-${lang}`);
      if (translatedText) {
        el.textContent = translatedText;
      }
    });

    const pageTitle = siteConfig.title[lang] ?? siteConfig.title.fr;
    document.title = `${siteConfig.name} - ${pageTitle}`;
  }

  updateLanguage(currentLang);

  toggleBtn?.addEventListener("click", () => {
    currentLang = currentLang === "fr" ? "en" : "fr";
    updateLanguage(currentLang);
  });
</script>
