---
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Projects from "../components/Projects.astro";
import Experience from "../components/Experience.astro";
import Education from "../components/Education.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../config";
import "../styles/global.css";
import { siteConfig } from "../config";
---

<header class="flex justify-between items-center p-6 max-w-4xl mx-auto">
  <h1 class="text-xl font-bold">{siteConfig.name}</h1>

  <!-- Bouton de changement de langue -->
  <button 
    id="lang-toggle" 
    class="px-3 py-1.5 text-sm font-medium border rounded-md transition hover:bg-gray-100 flex items-center gap-2 cursor-pointer"
  >
    🌐 <span id="lang-text">EN</span>
  </button>
</header>

<script>
  // Script exécuté côté client pour gérer le clic et stocker la langue
  const toggleBtn = document.getElementById('lang-toggle');
  const langText = document.getElementById('lang-text');

  // Récupérer la langue actuelle (par défaut 'fr')
  let currentLang = localStorage.getItem('portfolio-lang') || 'fr';

  function updateLanguage(lang: string) {
    localStorage.setItem('portfolio-lang', lang);
    if (langText) {
      langText.textContent = lang === 'fr' ? 'EN' : 'FR';
    }
    // Vous pouvez ici déclencher la mise à jour des textes de la page
    document.documentElement.setAttribute('data-lang', lang);
  }

  // Initialisation au chargement
  updateLanguage(currentLang);

  toggleBtn?.addEventListener('click', () => {
    currentLang = currentLang === 'fr' ? 'en' : 'fr';
    updateLanguage(currentLang);
    // Recharge la page pour appliquer la langue sur tous les composants statiques
    window.location.reload();
  });
</script>

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={siteConfig.description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=swap"
      rel="stylesheet"
    />
    <title>{siteConfig.name} - {siteConfig.title}</title>
  </head>
  <body>
    <Header />
    <section>
      <Hero />
      <About />
      <Projects />
      <Experience />
      <Education />
    </section>
    <Footer />
  </body>
</html>

